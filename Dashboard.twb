    <worksheet name='Treemap'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>ARR Distribution by Segment and Plan</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Red blocks (SMB)</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — biggest area, most customers, most ARR volume</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Orange blocks (Mid-Market)</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — medium sized</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Blue blocks (Enterprise)</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — right side, fewer customers but significant ARR</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Each block within a segment</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — represents a different plan type</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Tooltip at bottom</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — Mid-Market Basic plan = $511K ARR when you hover</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>The size of each rectangle = ARR. Bigger rectangle = more revenue from that segment/plan combination.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gold_revenue_risk' name='federated.0saklzh02qynxb1eekot905l91k4' />
