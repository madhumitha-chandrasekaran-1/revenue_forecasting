    <worksheet name='Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Churn Risk Heatmap: Segment vs Plan</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>SMB Basic — 13.00% churn</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — darkest red, highest risk combination in the entire business</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>SMB Enterprise plan — 14.82%</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — even higher, SMB customers on Enterprise plan churn the most</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>SMB Pro — 13.21%</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — all SMB combinations are red</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Mid-Market</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — light pink to salmon, moderate risk 2-3%</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Enterprise segment</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — all deep green, extremely safe at 0.02% to 0.56%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>The business insight this shows is powerful — it&apos;s not just that SMB churns more, it&apos;s that SMB customers on ANY plan type are high risk. Moving an SMB customer from Basic to Enterprise plan doesn&apos;t reduce their churn risk at all.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gold_revenue_risk' name='federated.0saklzh02qynxb1eekot905l91k4' />
          </datasources>
          <datasource-dependencies datasource='federated.0saklzh02qynxb1eekot905l91k4'>
