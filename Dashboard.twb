      <aliases enabled='yes' />
      <column caption='Risk Percentage' datatype='real' name='[Calculation_1440236525817856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue_risk]) / SUM([arr])' />
      </column>
      <column caption='Risk Tier' datatype='string' name='[Calculation_1440236526067713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [churn_probability] &gt;= 0.20 THEN &quot;High Risk&quot;&#10;ELSEIF [churn_probability] &gt;= 0.10 THEN &quot;Medium Risk&quot;&#10;ELSE &quot;Low Risk&quot;&#10;END' />
      </column>
      <column caption='Rentention Rate' datatype='real' name='[Calculation_1440236526374914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - AVG([churn_probability])' />
      </column>
