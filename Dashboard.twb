    <worksheet name='Risk Scatter'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Customer Risk Map — Churn Probability vs ARR</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Here&apos;s what it&apos;s telling you:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Three horizontal bands</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — that&apos;s your three plan types (Basic ~$1.2K, Pro ~$4K, Enterprise ~$12K ARR)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Orange dots (Low Risk)</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — clustered on the left, low churn probability</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Red dots (Medium Risk)</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — middle section</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Blue dots (High Risk)</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — spread across the right, high churn probability</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Dots on far right (0.8–1.0)</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> — these are your most dangerous customers, high churn probability</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>The Enterprise band at the top ($12K) with dots moving right is your most valuable insight — any Enterprise customer drifting toward high churn probability represents $12K+ ARR at risk per customer.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gold_revenue_risk' name='federated.0saklzh02qynxb1eekot905l91k4' />
          </datasources>
          <datasource-dependencies datasource='federated.0saklzh02qynxb1eekot905l91k4'>
            <column caption='Risk Tier' datatype='string' name='[Calculation_1440236526067713]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [churn_probability] &gt;= 0.20 THEN &quot;High Risk&quot;&#10;ELSEIF [churn_probability] &gt;= 0.10 THEN &quot;Medium Risk&quot;&#10;ELSE &quot;Low Risk&quot;&#10;END' />
            </column>
            <column caption='Arr' datatype='real' name='[arr]' role='measure' type='quantitative' />
            <column caption='Churn Probability' datatype='real' name='[churn_probability]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1440236526067713]' derivation='None' name='[none:Calculation_1440236526067713:nk]' pivot='key' type='nominal' />
            <column-instance column='[arr]' derivation='Sum' name='[sum:arr:qk]' pivot='key' type='quantitative' />
            <column-instance column='[churn_probability]' derivation='Sum' name='[sum:churn_probability:qk]' pivot='key' type='quantitative' />
